{
  "app": {
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [{ "name": "debug" }, { "name": "release" }]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    },
    { "name": "native_ability", "srcPath": "../../vendor/gpui-ohos/example/ohos/vendor/openharmony-ability/native_ability" },
    { "name": "plugin_app_control", "srcPath": "../../vendor/gpui-ohos/example/ohos/vendor/openharmony-ability/plugins/app-control" },
    { "name": "plugin_clipboard", "srcPath": "../../vendor/gpui-ohos/example/ohos/vendor/openharmony-ability/plugins/clipboard" },
    { "name": "plugin_files", "srcPath": "../../vendor/gpui-ohos/example/ohos/vendor/openharmony-ability/plugins/files" },
    { "name": "plugin_menu", "srcPath": "../../vendor/gpui-ohos/example/ohos/vendor/openharmony-ability/plugins/menu" },
    { "name": "plugin_permission", "srcPath": "../../vendor/gpui-ohos/example/ohos/vendor/openharmony-ability/plugins/permission" },
    { "name": "plugin_url", "srcPath": "../../vendor/gpui-ohos/example/ohos/vendor/openharmony-ability/plugins/url" },
    { "name": "plugin_notification", "srcPath": "../../vendor/gpui-ohos/example/ohos/vendor/openharmony-ability/plugins/notification" },
    { "name": "plugin_system_state", "srcPath": "../../vendor/gpui-ohos/example/ohos/vendor/openharmony-ability/plugins/system-state" },
    { "name": "plugin_window", "srcPath": "../../vendor/gpui-ohos/example/ohos/vendor/openharmony-ability/plugins/window" }
  ]
}
